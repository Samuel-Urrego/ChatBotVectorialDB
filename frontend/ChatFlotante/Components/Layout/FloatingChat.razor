@using System.Net.Http.Json
@inject HttpClient Http

<div class="chat-container">
    @if (isShowingSplash)
    {
        <div class="full-screen-awake">
            <img src="@(isClosing ? "cerdo.jpg" : "logo-awake.jpg")" class="mega-pig" />
            <h1 class="wake-text">@splashText</h1>
        </div>
    }

    @if (!isExpanded)
    {
        <button class="chat-launcher" @onclick="ToggleChat">
            @if (isWakingUp)
            {
                <img src="logo-awake.jpg" alt="Awake" class="logo-awake" />
            }
            else
            {
                <img src="logo-sleep.jpg" alt="Sleep" />
            }
        </button>
    }
    else
    {
        <div class="chat-window">
            <div class="chat-header">
                <div style="display:flex; align-items:center; gap:10px;">
                    <img src="logo-awake.jpg" alt="Awake" class="logo-awake" style="width:35px; height:35px; border-radius:50%; border:2px solid white;" />
                    <span>GeorgeGPT</span>
                </div>
                <button class="close-btn" @onclick="ToggleChat">✕</button>
            </div>
            <div class="chat-body">
                @foreach (var msg in messages)
                {
                    <div class="message @msg.Role">
                        @msg.Content
                    </div>
                }
                @if (isLoading)
                {
                    <div class="typing-indicator">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                }
            </div>
            <div class="chat-footer">
                <input @bind="userInput" @onkeyup="HandleKeyUp"
                       placeholder="Escribe aquí..." />
                <button @onclick="SendMessage">➤</button>
            </div>
        </div>
    }
</div>

@code {
    private bool isExpanded = false;
    private bool isShowingSplash = false;
    private bool isClosing = false;
    private bool isWakingUp = false; // Mantenemos para compatibilidad con el launcher si se usa
    private string splashText = "¡Hola!";
    private bool isLoading = false;
    private string userInput = "";
    private List<ChatMessage> messages = new() {
        new ChatMessage { Role = "bot", Content = "¡Hola! Soy tu asistente personal. ¿En qué puedo ayudarte?" }
    };

    private async Task ToggleChat()
    {
        if (!isExpanded)
        {
            // Secuencia de APERTURA
            isClosing = false;
            splashText = "¡Hola!";
            isShowingSplash = true;
            isWakingUp = true; // Para el launcher
            StateHasChanged();
            await Task.Delay(2000); 
            isExpanded = true;
            isShowingSplash = false;
            isWakingUp = false;
        }
        else
        {
            // Secuencia de CIERRE
            isExpanded = false; // Cerrar la ventana inmediatamente
            isClosing = true;
            splashText = "BYE!";
            isShowingSplash = true;
            StateHasChanged();
            await Task.Delay(2000); // Dar tiempo al splash de despedida
            isShowingSplash = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput)) return;

        var userText = userInput;
        messages.Add(new ChatMessage { Role = "user", Content = userText });
        userInput = "";
        
        isLoading = true;
        StateHasChanged();

        try
        {
            var request = new { question = userText };
            var response = await Http.PostAsJsonAsync("api/v1/ask", request);

            if (response.IsSuccessStatusCode)
            {
                using var stream = await response.Content.ReadAsStreamAsync();
                using var reader = new System.IO.StreamReader(stream);

                var botMessage = new ChatMessage { Role = "bot", Content = "" };
                messages.Add(botMessage);
                
                // Quitamos el indicador de carga cuando empieza a llegar el texto
                isLoading = false; 
                StateHasChanged();

                while (!reader.EndOfStream)
                {
                    char[] buffer = new char[1];
                    int readCount = await reader.ReadAsync(buffer, 0, 1);

                    if (readCount > 0)
                    {
                        botMessage.Content += buffer[0];
                        StateHasChanged();
                        await Task.Delay(10); // Velocidad pro
                    }
                }
            }
            else 
            {
                isLoading = false;
                messages.Add(new ChatMessage { Role = "bot", Content = "Lo siento, hubo un error con el servidor." });
            }
        }
        catch (Exception ex)
        {
            isLoading = false;
            messages.Add(new ChatMessage { Role = "bot", Content = "Error de conexión." });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public class ChatMessage { public string Role { get; set; } public string Content { get; set; } }
    public class ApiResponse { public string answer { get; set; } }
}