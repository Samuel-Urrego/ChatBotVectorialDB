@using System.Net.Http.Json
@inject HttpClient Http

<div class="chat-container">
    @if (!isExpanded)
    {
        <button class="chat-launcher" @onclick="ToggleChat">
            @* Si falla la imagen, el estilo del botón permite ver el fondo azul *@
            <img src="logo-bot.png" alt="🤖" style="width:100%; height:100%; border-radius:50%; object-fit:cover;"
                 onerror="this.style.display='none'" />
        </button>
    }
    else
    {
        <div class="chat-window">
            <div class="chat-header">
                <span>Asistente AI</span>
                <button @onclick="ToggleChat" style="background:none; border:none; color:white; cursor:pointer;">✕</button>
            </div>
            <div class="chat-body">
                @foreach (var msg in messages)
                {
                    <div class="message @msg.Role">
                        @msg.Content
                    </div>
                }
            </div>
            <div class="chat-footer" style="padding: 10px; display: flex;">
                <input @bind="userInput" @onkeyup="HandleKeyUp"
                       style="flex:1; border-radius:20px; padding:5px 15px; border:1px solid #ccc;"
                       placeholder="Escribe aquí..." />
                <button @onclick="SendMessage" style="margin-left:5px; background:none; border:none; color:#004a99;">➤</button>
            </div>
        </div>
    }
</div>

@code {
    private bool isExpanded = false;
    private string userInput = "";
    private List<ChatMessage> messages = new() {
        new ChatMessage { Role = "bot", Content = "¡Hola! Soy tu asistente personal. ¿En qué puedo ayudarte?" }
    };

    private void ToggleChat() => isExpanded = !isExpanded;

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput)) return;

        var userText = userInput;
        messages.Add(new ChatMessage { Role = "user", Content = userText });
        userInput = "";

        // Creamos el mensaje del bot vacío para ir llenándolo
        var botMessage = new ChatMessage { Role = "bot", Content = "" };
        messages.Add(botMessage);

        try
        {
            var request = new { question = userText };
            // Usamos PostAsync para tener control total sobre el stream de respuesta
            var response = await Http.PostAsJsonAsync("http://127.0.0.1:8000/api/v1/ask", request);

            if (response.IsSuccessStatusCode)
            {
                using var stream = await response.Content.ReadAsStreamAsync();
                using var reader = new System.IO.StreamReader(stream);

                // Leemos el stream caracter por caracter o por fragmentos pequeños
                while (!reader.EndOfStream)
                {
                    // Leemos el siguiente caracter disponible
                    char[] buffer = new char[1];
                    int readCount = await reader.ReadAsync(buffer, 0, 1);

                    if (readCount > 0)
                    {
                        botMessage.Content += buffer[0]; // Agregamos el caracter al mensaje
                        StateHasChanged(); // Forzamos a Blazor a re-renderizar la UI
                        await Task.Delay(15); // El toque mágico para el efecto de escritura
                    }
                }
            }
        }
        catch (Exception ex)
        {
            botMessage.Content = "Error de conexión: " + ex.Message;
        }
    }

    public class ChatMessage { public string Role { get; set; } public string Content { get; set; } }
    public class ApiResponse { public string answer { get; set; } }
}